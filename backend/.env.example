# Backend Environment Configuration (Vercel / Supabase Production)

# Environment & Debug
DEBUG=False
SECRET_KEY=generate-a-strong-random-key-here
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Supabase Database Connection String (PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Firebase Frontend URL
FRONTEND_URL=https://your-app-name.web.app

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Stripe API Credentials (Optional)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Google OAuth2 Credentials
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
